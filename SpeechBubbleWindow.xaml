<Window x:Class="DesktopPet.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid IsHitTestVisible="False">
        <Border Margin="3,3,3,10"
                Padding="11,8"
                VerticalAlignment="Bottom"
                MaxHeight="83"
                CornerRadius="14"
                BorderBrush="{StaticResource PaleJadeBrush}"
                BorderThickness="1.5"
                Background="{StaticResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="13"
                                  ShadowDepth="4"
                                  Color="#FF284852"
                                  Opacity="0.16"/>
            </Border.Effect>
            <TextBlock x:Name="SpeechText"
                       Foreground="{StaticResource InkBrush}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"/>
        </Border>

        <Polygon Points="0,0 16,0 8,9"
                 Width="16"
                 Height="9"
                 Margin="0,0,0,2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Fill="{StaticResource SurfaceBrush}"
                 Stroke="{StaticResource PaleJadeBrush}"
                 StrokeThickness="1.5"/>
    </Grid>
</Window>
