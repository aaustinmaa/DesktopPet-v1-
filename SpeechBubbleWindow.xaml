<Window x:Class="DesktopPet.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid IsHitTestVisible="False">
        <Border Margin="3,3,3,10"
                Padding="11,8"
                VerticalAlignment="Bottom"
                MaxHeight="83"
                CornerRadius="14"
                BorderBrush="#FF16131A"
                BorderThickness="2"
                Background="#FFF8F2DC">
            <Border.Effect>
                <DropShadowEffect BlurRadius="13"
                                  ShadowDepth="4"
                                  Opacity="0.24"/>
            </Border.Effect>
            <TextBlock x:Name="SpeechText"
                       Foreground="#FF16131A"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"/>
        </Border>

        <Polygon Points="0,0 16,0 8,9"
                 Width="16"
                 Height="9"
                 Margin="0,0,0,2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Fill="#FFF8F2DC"
                 Stroke="#FF16131A"
                 StrokeThickness="2"/>
    </Grid>
</Window>
