<Window x:Class="DesktopPet.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度"
        Width="480" Height="700"
        MinWidth="430" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanMinimize"
        Icon="Assets/app.ico"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,26">
            <TextBlock Text="苏无度"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="30"/>
            <TextBlock Text="桌宠控制面板"
                       Style="{StaticResource PageSubtitleStyle}"/>
            <Border Style="{StaticResource TitleRuleStyle}"/>

            <Border Margin="0,20,0,16"
                    Style="{StaticResource InfoCalloutStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="10"
                            Height="10"
                            Margin="2,2,12,0"
                            CornerRadius="5"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="苏无度正在运行"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="关闭这个面板不会退出桌宠。她会继续待在桌面或系统托盘中。"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource ModernCardStyle}"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="快速操作"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="2,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="48"
                                Margin="0"
                                Content="叫醒苏无度"
                                Click="Wake_Click"/>
                        <Button Grid.Column="2"
                                Height="48"
                                Margin="0"
                                Content="和她聊聊"
                                Click="Chat_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCardStyle}"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="管理"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="2,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button Height="44"
                                Margin="0,0,5,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="设置"
                                Click="Settings_Click"/>
                        <Button Height="44"
                                Margin="5,0,0,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="使用说明"
                                Click="Help_Click"/>
                        <Button Height="44"
                                Margin="0,0,5,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="今日专注记录"
                                Click="FocusJournal_Click"/>
                        <Button Height="44"
                                Margin="5,0,0,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="创建桌面快捷方式"
                                Click="DesktopShortcut_Click"/>
                        <Button Height="44"
                                Margin="0,0,5,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="把桌宠收起来"
                                Click="TuckAway_Click"/>
                        <Button Height="44"
                                Margin="5,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="完全退出"
                                Click="Exit_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InnerPanelStyle}">
                <TextBlock Text="提示：右键桌面上的苏无度，可以更快地进入聊天、专注、设置和其它常用功能。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
