<Window x:Class="DesktopPet.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度"
        Width="450" Height="640"
        MinWidth="410" MinHeight="540"
        MaxWidth="520" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/app.ico"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,20,22,22">
            <TextBlock Text="苏无度"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="30"/>
            <TextBlock Text="桌宠控制面板"
                       Style="{StaticResource PageSubtitleStyle}"/>
            <Border Style="{StaticResource TitleRuleStyle}"/>

            <Border Style="{StaticResource ModernCardStyle}"
                    Margin="0,20,0,14">
                <StackPanel>
                    <TextBlock Text="快速操作"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="2,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="48"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="叫醒苏无度"
                                Click="Wake_Click"/>
                        <Button Grid.Column="2"
                                Height="48"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="和她聊聊"
                                Click="Chat_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCardStyle}"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="管理"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="2,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button Height="44"
                                Margin="0,0,5,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="设置"
                                Click="Settings_Click"/>
                        <Button Height="44"
                                Margin="5,0,0,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="使用说明"
                                Click="Help_Click"/>
                        <Button Height="44"
                                Margin="0,0,5,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="今日专注记录"
                                Click="FocusJournal_Click"/>
                        <Button Height="44"
                                Margin="5,0,0,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="创建桌面快捷方式"
                                Click="DesktopShortcut_Click"/>
                        <Button Height="44"
                                Margin="0,0,5,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="把桌宠收起来"
                                Click="TuckAway_Click"/>
                        <Button Height="44"
                                Margin="5,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="完全退出"
                                Click="Exit_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InnerPanelStyle}">
                <TextBlock Text="提示：右键桌面上的苏无度，可以更快地进入聊天、专注、设置和其它常用功能。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
