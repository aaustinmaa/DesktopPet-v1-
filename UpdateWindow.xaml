<Window x:Class="DesktopPet.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度更新"
        Width="520" Height="490"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        Background="{StaticResource PanelBrush}"
        Icon="Assets/app.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="苏无度有新版本啦"
                       FontSize="25" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="VersionText" Margin="0,7,0,0"
                       FontSize="13" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="更新内容" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"/>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                               FontSize="13" LineHeight="21"
                               Foreground="{StaticResource MutedBrush}"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <ProgressBar x:Name="DownloadProgress" Height="8"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Margin="0,9,0,0"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ReleasePageButton" Grid.Column="0" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="在 GitHub 查看" Click="ReleasePage_Click"/>
            <Button x:Name="LaterButton" Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="稍后" Click="Later_Click"/>
            <Button x:Name="UpdateButton" Grid.Column="3" MinWidth="126"
                    Content="下载并更新" Click="Update_Click"/>
        </Grid>
    </Grid>
</Window>
