<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度桌宠"
        Width="190" Height="218"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Image x:Name="PetImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseRightButtonUp="PetImage_MouseRightButtonUp">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetBounceScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PetTranslate"/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.RenderTransformOrigin>0.5,0.82</Image.RenderTransformOrigin>
            <Image.ContextMenu>
                <ContextMenu x:Name="PetMenu"
                             FontFamily="Microsoft YaHei UI"
                             Closed="PetMenu_Closed">
                    <MenuItem Header="💬 和我聊聊" Click="Chat_Click"/>
                    <MenuItem Header="💚 给我一点鼓励" Click="Cheer_Click"/>
                    <MenuItem Header="🎭 命令她做动作">
                        <MenuItem Header="💚 比心" Tag="Heart" Click="PetAction_Click"/>
                        <MenuItem Header="😉 眨眼" Tag="Blink" Click="PetAction_Click"/>
                        <MenuItem Header="👋 挥手" Tag="Wave" Click="PetAction_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="WorkModeItem" Header="💻 工作模式" IsCheckable="True" Click="WorkMode_Click"/>
                    <MenuItem x:Name="RestModeItem" Header="😴 睡眠模式" IsCheckable="True" Click="RestMode_Click"/>
                    <MenuItem x:Name="StartFocusItem" Header="⏱ 开始专注计时" Click="StartFocus_Click"/>
                    <MenuItem x:Name="PauseFocusItem" Header="⏸ 暂停专注计时" IsEnabled="False" Click="PauseFocus_Click"/>
                    <MenuItem x:Name="StopFocusItem" Header="■ 停止专注计时" IsEnabled="False" Click="StopFocus_Click"/>
                    <MenuItem Header="📊 今日专注记录" Click="FocusJournal_Click"/>
                    <Separator/>
                    <MenuItem x:Name="WanderItem" Header="🐾 自动漫游" IsCheckable="True" Click="Wander_Click"/>
                    <MenuItem x:Name="TopmostItem" Header="📌 始终置顶" IsCheckable="True" Click="Topmost_Click"/>
                    <MenuItem x:Name="ClickThroughItem" Header="👻 鼠标穿透（Ctrl+Alt+P 恢复）" IsCheckable="True" Click="ClickThrough_Click"/>
                    <Separator/>
                    <MenuItem Header="🏠 打开启动面板" Click="Launcher_Click"/>
                    <MenuItem Header="📖 使用说明书" Click="Help_Click"/>
                    <MenuItem Header="⚙ 设置" Click="Settings_Click"/>
                    <MenuItem Header="🌙 收起来" Click="TuckAway_Click"/>
                    <MenuItem Header="✕ 退出" Click="Exit_Click"/>
                </ContextMenu>
            </Image.ContextMenu>
        </Image>

        <Viewbox x:Name="SleepZzzLayer"
                 Stretch="Uniform"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"
                 Panel.ZIndex="1"
                 SnapsToDevicePixels="True">
            <Canvas Width="362" Height="362">
                <Image x:Name="SleepZSmallImage"
                       Canvas.Left="252" Canvas.Top="72"
                       Width="14" Height="17"
                       Opacity="0"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SleepZSmallScale"/>
                            <TranslateTransform x:Name="SleepZSmallTranslate"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="SleepZMediumImage"
                       Canvas.Left="268" Canvas.Top="49"
                       Width="26" Height="31"
                       Opacity="0"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SleepZMediumScale"/>
                            <TranslateTransform x:Name="SleepZMediumTranslate"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="SleepZLargeImage"
                       Canvas.Left="294" Canvas.Top="4"
                       Width="32" Height="40"
                       Opacity="0"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SleepZLargeScale"/>
                            <TranslateTransform x:Name="SleepZLargeTranslate"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Viewbox>

        <Image x:Name="HammerImage"
               Width="74"
               Height="74"
               Margin="28,0,0,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Stretch="Uniform"
               Visibility="Collapsed"
               Opacity="0"
               IsHitTestVisible="False"
               Panel.ZIndex="2"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderTransformOrigin="0.5,0.58">
            <Image.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="HammerRotate"/>
                    <TranslateTransform x:Name="HammerTranslate"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
