<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度桌宠"
        Width="190" Height="218"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="SpeechBubble"
                Grid.Row="0"
                MaxWidth="184"
                Margin="3,0,3,4"
                Padding="11,8"
                CornerRadius="14"
                BorderBrush="#FF16131A"
                BorderThickness="2"
                Background="#FFF8F2DC"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="13" ShadowDepth="4" Opacity="0.24"/>
            </Border.Effect>
            <TextBlock x:Name="SpeechText"
                       Foreground="#FF16131A"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1">
            <Image x:Name="PetImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   SnapsToDevicePixels="True"
                   MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
                   MouseRightButtonUp="PetImage_MouseRightButtonUp">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetBounceScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="PetTranslate"/>
                    </TransformGroup>
                </Image.RenderTransform>
                <Image.RenderTransformOrigin>0.5,0.82</Image.RenderTransformOrigin>
                <Image.ContextMenu>
                    <ContextMenu x:Name="PetMenu" FontFamily="Microsoft YaHei UI">
                        <MenuItem Header="💬 和我聊聊" Click="Chat_Click"/>
                        <MenuItem Header="💚 给我一点鼓励" Click="Cheer_Click"/>
                        <Separator/>
                        <MenuItem x:Name="WorkModeItem" Header="💻 工作模式" IsCheckable="True" Click="WorkMode_Click"/>
                        <MenuItem Header="⏱ 开始专注计时" Click="StartFocus_Click"/>
                        <MenuItem x:Name="StopFocusItem" Header="■ 停止专注计时" IsEnabled="False" Click="StopFocus_Click"/>
                        <Separator/>
                        <MenuItem x:Name="WanderItem" Header="🐾 自动漫游" IsCheckable="True" Click="Wander_Click"/>
                        <MenuItem x:Name="TopmostItem" Header="📌 始终置顶" IsCheckable="True" Click="Topmost_Click"/>
                        <MenuItem x:Name="ClickThroughItem" Header="👻 鼠标穿透（Ctrl+Alt+P 恢复）" IsCheckable="True" Click="ClickThrough_Click"/>
                        <MenuItem Header="🔍 大小">
                            <MenuItem Header="小" Tag="0.65" Click="Size_Click"/>
                            <MenuItem Header="默认" Tag="0.82" Click="Size_Click"/>
                            <MenuItem Header="大" Tag="1.10" Click="Size_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="📖 使用说明书" Click="Help_Click"/>
                        <MenuItem Header="⚙ 设置" Click="Settings_Click"/>
                        <MenuItem Header="🌙 收起来" Click="TuckAway_Click"/>
                        <MenuItem Header="✕ 退出" Click="Exit_Click"/>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Grid>
    </Grid>
</Window>
