<Window x:Class="DesktopPet.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度使用说明书"
        Width="660" Height="760"
        MinWidth="520" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,25,28,28">
                <TextBlock Text="苏无度使用说明书"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="她平时的小动作主要是陪伴动画，不是在偷偷读取你的屏幕。"
                           Margin="0,5,0,20"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="一分钟上手" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23">
                            <Run FontWeight="Bold">拖动：</Run><Run>按住苏无度并移动鼠标。&#x0a;</Run>
                            <Run FontWeight="Bold">番茄钟：</Run><Run>双击苏无度；没有计时器时开始，运行中暂停，暂停后继续。&#x0a;</Run>
                            <Run FontWeight="Bold">聊天：</Run><Run>连续点击苏无度三次。&#x0a;</Run>
                            <Run FontWeight="Bold">叫醒：</Run><Run>睡眠状态下，4 秒内完成两次分开的单击锤击；快速双击仍用于番茄钟。&#x0a;</Run>
                            <Run FontWeight="Bold">功能菜单：</Run><Run>右键苏无度。&#x0a;</Run>
                            <Run FontWeight="Bold">文字气泡：</Run><Run>会自然显示在她头顶，不会缩小人物；气泡区域始终鼠标穿透。&#x0a;</Run>
                            <Run FontWeight="Bold">暂时隐藏：</Run><Run>右键选择“收起来”，双击托盘图标或再次启动即可叫回。&#x0a;</Run>
                            <Run FontWeight="Bold">紧急恢复鼠标：</Run><Run>按 Ctrl + Alt + P，可关闭鼠标穿透并叫回她。</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="它到底是什么应用？" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23">
                            <Run>苏无度是一个真正的 Windows 桌面应用。</Run>
                            <Run FontWeight="Bold">SuWuDu.exe</Run>
                            <Run>是应用的主程序；“exe”只是 Windows 可执行程序的文件格式。&#x0a;&#x0a;</Run>
                            <Run FontWeight="Bold">安装版：</Run><Run>运行“苏无度安装程序.exe”后，Windows 会把她放进你的用户应用目录，并创建开始菜单、桌面和卸载入口。之后直接在开始菜单搜索“苏无度”即可，不需要再找文件夹。&#x0a;</Run>
                            <Run FontWeight="Bold">便携版：</Run><Run>也能直接运行，但 Windows 不会自动把任意文件夹里的 exe 当作已登记应用；移动文件夹后，旧快捷方式也可能失效。&#x0a;</Run>
                            <Run FontWeight="Bold">任务栏：</Run><Run>桌宠本体故意不占任务栏。手动启动时出现的“苏无度启动面板”才是可固定的入口；右键它的任务栏图标即可固定。关闭面板不会退出桌宠。&#x0a;</Run>
                            <Run FontWeight="Bold">重新打开：</Run><Run>苏无度已运行时，再点开始菜单、桌面快捷方式或固定图标，会打开启动面板并把现有桌宠叫回来，不会多开一只。</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="她为什么会做这些动作？" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontWeight="Bold" Text="眨眼"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="随机的自然待机动作，没有特殊提醒。" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" FontWeight="Bold" Text="比心"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="随机表达陪伴；鼓励、聊天或完成任务时也可能出现。" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontWeight="Bold" Text="挥手"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="打招呼、被叫回来，或随机和你互动。" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Margin="0,8,0,0" FontWeight="Bold" Text="工作"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="工作模式、专注计时、AI 正在回复，或外部工具发来 working 状态。" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Margin="0,8,0,0" FontWeight="Bold" Text="睡觉"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="电脑大约五分钟没有操作，她会休息；你回来后会醒来。" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Margin="0,8,0,0" FontWeight="Bold" Text="铃铛"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="喝水提醒或需要你注意的消息。" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="6" Margin="0,8,0,0" FontWeight="Bold" Text="成功/疑惑"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="专注完成、AI 回复情绪，或 Codex/脚本明确发送的任务状态。" TextWrapping="Wrap"/>
                        </Grid>
                        <Border Margin="0,13,0,0"
                                Style="{StaticResource InfoCalloutStyle}">
                            <TextBlock Text="重点：平时随机眨眼、比心和挥手只是装饰动画，不代表有新通知。真正的提醒通常会同时出现文字气泡或托盘通知。"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="右键菜单功能" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23">
                            <Run FontWeight="Bold">和我聊聊：</Run><Run>打开通用聊天；推荐在设置中直接连接自己的 ChatGPT。&#x0a;</Run>
                            <Run FontWeight="Bold">给我一点鼓励：</Run><Run>显示一句鼓励并播放比心动画。&#x0a;</Run>
                            <Run FontWeight="Bold">工作模式：</Run><Run>让苏无度保持工作状态，直到你关闭它。&#x0a;</Run>
                            <Run FontWeight="Bold">专注计时：</Run><Run>一个番茄钟就是一个专注 block。可以暂停、继续或停止；暂停时间不会计入已完成分钟。手动停止时，凑齐完整番茄钟就自动记录，否则把已完成的整分钟加入“今日分钟调整”。单击苏无度可查看 4 秒动态剩余时间。&#x0a;</Run>
                            <Run FontWeight="Bold">随机提示音：</Run><Run>只在番茄钟内运行。系统每轮在最短/最长间隔内重新随机抽取时间；第一声开始微休息，休息指定秒数后第二声继续工作。&#x0a;</Run>
                            <Run FontWeight="Bold">今日专注记录：</Run><Run>记录日以晚上 9 点为分界；跨过 9 点的专注分钟会自动拆到前后两个记录日。窗口中可以设置每日目标和分钟调整、补记或删除番茄钟、填写每日及单次 Notes、复制当天纯文本，并按日期范围导出 Markdown。&#x0a;</Run>
                            <Run FontWeight="Bold">自动漫游：</Run><Run>让她偶尔在附近轻轻移动。&#x0a;</Run>
                            <Run FontWeight="Bold">始终置顶：</Run><Run>保持在其它普通窗口上方。&#x0a;</Run>
                            <Run FontWeight="Bold">鼠标穿透：</Run><Run>鼠标会点到她后面的窗口；用 Ctrl + Alt + P 恢复。&#x0a;</Run>
                            <Run FontWeight="Bold">设置：</Run><Run>修改名字、大小、提醒、番茄钟与随机提示音、开机启动、聊天方式和本地记忆。四类铃声都可分别试听或设为静音。&#x0a;</Run>
                            <Run FontWeight="Bold">收起来：</Run><Run>隐藏到系统托盘，不会退出程序。</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AI、隐私与 Codex 联动" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="苏无度默认不会读取屏幕或项目文件。只有你在聊天窗口手动开启“看屏幕”后，她才会在点击发送的瞬间截取一张所有显示器画面；不会持续录屏。ChatGPT 模式通过官方 Codex OAuth 登录，她不会询问或保存你的 ChatGPT 密码。API key 模式只在本机用 Windows DPAPI 加密 key。离线模式完全不联网。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="开启“聊天记忆”后，最近聊天和你明确说“记住……”的内容保存在本机 LocalAppData，不与 ChatGPT 网页记忆同步。可以随时在设置里一键清除。Codex 或其它脚本只有主动发送状态命令时，才会改变她的任务动作。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="ChatGPT 模式的模型和推理强度都是下拉选项，由当前账号实时提供。建议使用“自动选择”；若手动调整，较高的推理强度通常回答更慢，也会使用更多推理 token。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="聊天窗口右上角的齿轮可以直接打开设置。保存后，下一条消息会立即使用新的聊天方式、模型和推理强度。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="“看屏幕”默认关闭且只在当前聊天中生效。开启时，每条消息只发送一张静态截图；临时截图会在请求结束后从本机删除。发送前请先关闭或移走密码、付款信息、私人聊天等敏感内容。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Style="{StaticResource FooterBarStyle}">
            <Button Content="看懂了"
                    Width="105"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
