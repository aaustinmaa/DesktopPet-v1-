<Window x:Class="DesktopPet.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度使用说明书"
        Width="660" Height="760"
        MinWidth="520" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}">
    <Window.Resources>
        <Style x:Key="HelpBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HelpMutedTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HelpBodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="HelpFeatureTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,25,28,28">
                <TextBlock Text="苏无度使用说明书"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="先认识两个最好用的功能，再按自己的习惯慢慢探索。"
                           Margin="0,5,0,20"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
                <Border Style="{StaticResource TitleRuleStyle}"
                        Margin="0,-8,0,20"/>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="最值得先用的两个功能"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,5,0,14"
                                   Text="这也是苏无度和普通桌宠最不一样的地方。"
                                   Style="{StaticResource HelpMutedTextStyle}"/>

                        <Border Style="{StaticResource InnerPanelStyle}"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="聊天可以直接看屏幕"
                                               Style="{StaticResource HelpFeatureTitleStyle}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="不用再截图、保存、上传。“看屏幕”首次默认开启并会记住上次选择；发送时，苏无度会把你的问题和发送瞬间的桌面画面一起看懂。"
                                               Style="{StaticResource HelpBodyTextStyle}"/>
                                    <TextBlock Margin="0,7,0,0"
                                               Text="三击苏无度 → 确认“看屏幕” → 输入问题 → 发送"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="很适合直接问报错、网页、设计稿或文档排版。每次只看一张静态截图，不会持续录屏。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource InnerPanelStyle}"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="双击就开始专注"
                                               Style="{StaticResource HelpFeatureTitleStyle}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="不需要另外打开计时器。双击开始，再双击暂停或继续；完成后会自动写进专注记录。"
                                               Style="{StaticResource HelpBodyTextStyle}"/>
                                    <TextBlock Margin="0,7,0,0"
                                               Text="双击开始 → 双击暂停 → 双击继续"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="常用操作" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontWeight="Bold" Text="移动"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="按住苏无度并拖到喜欢的位置。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="单击"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0"
                                       Text="和她互动；专注中还会显示剩余时间。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="右键"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,9,0,0"
                                       Text="打开聊天、模式、计时、记录和设置等完整菜单。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="叫醒"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                                       Text="睡觉时在 4 秒内完成两次分开的单击；快速双击仍然是专注操作。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="点不到她"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,9,0,0"
                                       Text="按 Ctrl + Alt + P，立即关闭鼠标穿透并把她叫回来。"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="专注计时" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="在“设置 → 专注与提醒”中选择默认时长和开始、结束铃声。计时中单击苏无度，会显示 4 秒动态倒计时。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="暂停与继续"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="直接双击，或使用右键菜单。暂停时间不会算进专注分钟。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="停止或重新开始"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="在右键菜单或托盘菜单中操作。提前停止时，已经完成的整分钟仍会加入当天记录；不到 1 分钟则不记录。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="意外退出或关机"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="下次启动会找回未完成的计时，并以暂停状态等待你双击继续。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="随机微休息"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="开启后，专注期间会不定时提醒你短暂休息，再播放继续工作的声音。间隔、休息时长和两种声音都可以修改。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="查看和整理专注记录" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="打开右键菜单、托盘菜单或启动面板中的“今日专注记录”。完成一个番茄钟后，它会自动出现在记录里。你可以切换日期、设置每日目标、补记或删除番茄钟、调整当天分钟数，并为当天或单次专注填写 Notes。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="需要分享或备份时，可以复制当天纯文本，也可以选择日期范围导出 Markdown。记录日以晚上 9 点为分界；跨过晚上 9 点的专注分钟会分别计入前后两个记录日。"
                                   Style="{StaticResource HelpMutedTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="更多聊天设置" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="三击苏无度，或在右键菜单中选择“和我聊聊”。每次打开默认开始新聊天；展开左侧列表可以继续已保存聊天、新建聊天，或归档和恢复聊天。标题会根据第一条消息自动生成。输入后按 Enter 发送，按 Shift + Enter 换行；每条消息都可以复制。聊天窗口右上角的齿轮可随时打开设置。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="ChatGPT 登录（推荐）"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="在设置中点击“连接我的 ChatGPT”，按浏览器提示完成登录。模型和推理强度保持“自动选择”通常最省心。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="API key"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="适合使用 OpenAI 开发者 API 的用户，费用与 ChatGPT 订阅分开。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="离线"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="完全不联网，提供简单的陪伴式回复；离线模式不能使用“看屏幕”。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="聊天保存与记忆"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="所有非空聊天都会自动保存在本机，归档只整理列表，不会删除内容。“开启记忆功能”控制苏无度是否跨聊天使用精简摘要和你明确要求“记住”的内容；关闭记忆不会停止保存聊天。可以在设置中一键清除所有聊天与记忆。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="日常陪伴与提醒" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontWeight="Bold" Text="工作 / 睡眠"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="两种模式不会同时开启。电脑约 5 分钟没有操作时，她也会自动睡觉。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="喝水提醒"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0"
                                       Text="按设置的间隔显示气泡和系统通知。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="自动漫游"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,9,0,0"
                                       Text="让她偶尔在当前屏幕附近轻轻移动。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="始终置顶"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                                       Text="让她留在普通窗口上方。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="鼠标穿透"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,9,0,0"
                                       Text="让点击落到她后面的窗口；用 Ctrl + Alt + P 恢复。"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Margin="0,9,0,0"
                                       FontWeight="Bold" Text="更多互动"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,9,0,0"
                                       Text="右键可让她比心、眨眼、挥手，或给你一句鼓励。"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Border Margin="0,13,0,0"
                                Style="{StaticResource InfoCalloutStyle}">
                            <TextBlock Text="随机眨眼、比心和挥手只是陪伴动画，不代表有新通知。真正的提醒通常会同时出现文字气泡或系统通知。"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="收起来、叫回来和退出" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="暂时收起来"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="右键选择“收起来”，她会隐藏到系统托盘，但计时和提醒仍会继续。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="叫回来"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="双击托盘图标、点击启动面板中的“叫醒苏无度”，或再次启动苏无度。再次启动不会出现第二只。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,9,0,0"
                                   Text="启动面板与完全退出"
                                   FontWeight="Bold"/>
                        <TextBlock Margin="0,3,0,0"
                                   Text="启动面板可以进入聊天、设置和专注记录。关闭面板不会关闭桌宠；需要完全退出时，请使用菜单中的“退出”。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="屏幕与隐私" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="“看屏幕”首次默认开启并会保留你上次的开关选择；只有它开启时，苏无度才会在发送瞬间截取一张所有显示器的静态画面。聊天窗口本身不会出现在截图里，窗口后面的原始桌面内容仍会保留。发送前请移开密码、付款信息和私人聊天等敏感内容；临时截图会在本次请求结束后删除。"
                                   Style="{StaticResource HelpBodyTextStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="设置、专注记录和聊天记忆保存在当前电脑账户中，不会与 ChatGPT 网页版记忆同步。API key 会由 Windows 为当前账户加密保存；离线聊天不会发送任何内容。聊天与记忆可以在设置中随时清除。"
                                   Style="{StaticResource HelpMutedTextStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Style="{StaticResource FooterBarStyle}"
                Background="{StaticResource AccentSoftBrush}"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="三击聊天 · 双击专注"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="关掉说明书后，马上试试。"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="开始使用"
                        Width="112"
                        Margin="18,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsDefault="True"
                        Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
