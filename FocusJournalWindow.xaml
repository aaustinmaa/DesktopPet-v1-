<Window x:Class="DesktopPet.FocusJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度 · 专注记录"
        Width="820" Height="800"
        MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="Assets/app.ico"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="JournalHoverBrush" Color="#FFD9E9E6"/>
        <SolidColorBrush x:Key="JournalSelectedBrush" Color="#FFC2DDD8"/>
        <SolidColorBrush x:Key="JournalSelectedHoverBrush" Color="#FFB2D2CC"/>

        <Style x:Key="DayNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="JournalDateButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="178"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"
                    Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"/>
                            <Border x:Name="HoverSurface"
                                    Background="{StaticResource JournalHoverBrush}"
                                    CornerRadius="7"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverSurface"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverSurface"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="专注记录"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="查看、补记和整理每天完成的番茄钟。"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Border Style="{StaticResource TitleRuleStyle}"
                            Margin="0,9,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource DayNavigationButtonStyle}"
                            ToolTip="前一天"
                            Click="PreviousDay_Click">
                        <Path Width="8"
                              Height="14"
                              Data="M 8,1 L 2,7 L 8,13"
                              Stroke="{StaticResource InkBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>

                    <Grid>
                        <Button x:Name="JournalDateButton"
                                Style="{StaticResource JournalDateButtonStyle}"
                                ToolTip="选择记录日期"
                                Click="JournalDateButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="8"
                                        Background="{StaticResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <Path Width="13"
                                          Height="13"
                                          Data="M 3,1 L 3,4 M 9,1 L 9,4 M 1,4 L 11,4 M 2,2 L 10,2 L 11,3 L 11,11 L 1,11 L 1,3 Z"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="记录日"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="JournalDateText"
                                               Margin="0,-1,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <Path Grid.Column="2"
                                      Width="9"
                                      Height="5"
                                      Data="M 1,1 L 4.5,4 L 8,1"
                                      Stroke="{StaticResource MutedBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Fill"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Popup x:Name="JournalCalendarPopup"
                               PlacementTarget="{Binding ElementName=JournalDateButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Margin="0,7,0,0"
                                    Padding="10"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22"
                                                      ShadowDepth="6"
                                                      Opacity="0.18"/>
                                </Border.Effect>
                                <Calendar x:Name="JournalCalendar"
                                          Width="280"
                                          Language="zh-CN"
                                          FontFamily="Microsoft YaHei UI"
                                          FontSize="13"
                                          Foreground="{StaticResource InkBrush}"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          SelectionMode="SingleDate"
                                          SelectedDatesChanged="JournalCalendar_SelectedDatesChanged">
                                    <Calendar.Resources>
                                        <Style x:Key="ModernCalendarDayButtonStyle"
                                               TargetType="{x:Type CalendarDayButton}">
                                            <Setter Property="Width" Value="34"/>
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="Margin" Value="1"/>
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource InkBrush}"/>
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderThickness"
                                                    Value="1"/>
                                            <Setter Property="FocusVisualStyle"
                                                    Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                                                        <Grid>
                                                            <Border x:Name="SelectedSurface"
                                                                    Background="{StaticResource JournalSelectedBrush}"
                                                                    CornerRadius="8"
                                                                    Opacity="0"
                                                                    IsHitTestVisible="False"/>
                                                            <Border x:Name="HoverSurface"
                                                                    Background="{StaticResource JournalHoverBrush}"
                                                                    CornerRadius="8"
                                                                    Opacity="0"
                                                                    IsHitTestVisible="False"/>
                                                            <Border x:Name="DayBorder"
                                                                    Background="Transparent"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="8">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="HoverSurface"
                                                                                Storyboard.TargetProperty="Opacity"
                                                                                To="1"
                                                                                Duration="0:0:0.14"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="HoverSurface"
                                                                                Storyboard.TargetProperty="Opacity"
                                                                                To="0"
                                                                                Duration="0:0:0.12"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <Trigger Property="IsToday"
                                                                     Value="True">
                                                                <Setter TargetName="DayBorder"
                                                                        Property="BorderBrush"
                                                                        Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected"
                                                                     Value="True">
                                                                <Setter TargetName="SelectedSurface"
                                                                        Property="Opacity"
                                                                        Value="1"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="FontWeight"
                                                                        Value="SemiBold"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected"
                                                                               Value="True"/>
                                                                    <Condition Property="IsMouseOver"
                                                                               Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="HoverSurface"
                                                                        Property="Background"
                                                                        Value="{StaticResource JournalSelectedHoverBrush}"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsInactive"
                                                                     Value="True">
                                                                <Setter Property="Opacity"
                                                                        Value="0.36"/>
                                                            </Trigger>
                                                            <Trigger Property="IsBlackedOut"
                                                                     Value="True">
                                                                <Setter Property="Opacity"
                                                                        Value="0.25"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Calendar.Resources>
                                </Calendar>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Style="{StaticResource DayNavigationButtonStyle}"
                            ToolTip="后一天"
                            Click="NextDay_Click">
                        <Path Width="8"
                              Height="14"
                              Data="M 2,1 L 8,7 L 2,13"
                              Stroke="{StaticResource InkBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                    <Button Content="今天"
                            Width="58"
                            Height="40"
                            Padding="0"
                            Margin="8,0,0,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource DayNavigationButtonStyle}"
                            Click="Today_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,28">
                <Border Style="{StaticResource ModernCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="完成 / 目标"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="CompletedSummaryText"
                                           Margin="0,4,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="番茄钟时间"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SessionMinutesText"
                                           Margin="0,4,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最终计入"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TotalMinutesText"
                                           Margin="0,4,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="GoalProgress"
                                     Height="9"
                                     Margin="0,15,0,15"
                                     Minimum="0"
                                     Maximum="1"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="今日目标（个）"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="TargetCountBox"
                                         Margin="0,5,0,0"
                                         HorizontalContentAlignment="Center"
                                         TextChanged="DayField_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="今日分钟调整（可正可负）"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="MinuteAdjustmentBox"
                                         Margin="0,5,0,0"
                                         HorizontalContentAlignment="Center"
                                         TextChanged="DayField_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="番茄钟"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="完成时自动记录，也可以手动补记或删除。"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ 补记一个番茄钟"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AddManualSession_Click"/>
                        </Grid>

                        <TextBlock x:Name="EmptySessionsText"
                                   Text="这一天还没有番茄钟记录。"
                                   Padding="0,16"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <ItemsControl x:Name="SessionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,9">
                                        <Expander Header="{Binding Header}"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  FontWeight="SemiBold">
                                            <StackPanel Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="分钟数"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBox Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,4,12,0"
                                                                 HorizontalContentAlignment="Center"
                                                                 TextChanged="SessionText_Changed"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              Content="计入完成数量"
                                                              Margin="0,17,0,0"
                                                              IsChecked="{Binding CountsTowardGoal, Mode=TwoWay}"
                                                              Checked="SessionField_Changed"
                                                              Unchecked="SessionField_Changed"/>
                                                    <Button Grid.Column="2"
                                                            Content="删除"
                                                            Margin="10,11,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="DeleteSession_Click"/>
                                                </Grid>

                                                <TextBlock Text="这个番茄钟的 Notes"
                                                           Margin="0,10,0,4"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="58"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextChanged="SessionText_Changed"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="今日 Notes"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox x:Name="DailyNotesBox"
                                 Margin="0,10,0,0"
                                 MinHeight="110"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="DayField_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="复制当天文本"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyDay_Click"/>
                    <Button Content="导出 Markdown"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExportMarkdown_Click"/>
                    <Button Content="保存"
                            Width="88"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
