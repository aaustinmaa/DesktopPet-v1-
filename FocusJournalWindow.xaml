<Window x:Class="DesktopPet.FocusJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度 · 专注记录"
        Width="760" Height="780"
        MinWidth="650" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="Assets/app.ico"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="专注记录"
                               FontSize="27"
                               FontWeight="Bold"/>
                    <TextBlock Text="查看、补记和整理每天完成的番茄钟。"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="‹"
                            Width="38"
                            Height="36"
                            FontSize="20"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="PreviousDay_Click"/>
                    <DatePicker x:Name="JournalDatePicker"
                                Width="150"
                                Margin="8,0"
                                SelectedDateChanged="JournalDatePicker_SelectedDateChanged"/>
                    <Button Content="›"
                            Width="38"
                            Height="36"
                            FontSize="20"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="NextDay_Click"/>
                    <Button Content="今天"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Today_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <Border Style="{StaticResource ModernCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="完成 / 目标"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="CompletedSummaryText"
                                           Margin="0,4,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="番茄钟时间"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SessionMinutesText"
                                           Margin="0,4,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最终计入"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TotalMinutesText"
                                           Margin="0,4,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="GoalProgress"
                                     Height="9"
                                     Margin="0,15,0,15"
                                     Minimum="0"
                                     Maximum="1"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="今日目标（个）"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="TargetCountBox"
                                         Margin="0,5,0,0"
                                         HorizontalContentAlignment="Center"
                                         TextChanged="DayField_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="今日分钟调整（可正可负）"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="MinuteAdjustmentBox"
                                         Margin="0,5,0,0"
                                         HorizontalContentAlignment="Center"
                                         TextChanged="DayField_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="番茄钟"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="完成时自动记录，也可以手动补记或删除。"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ 补记一个番茄钟"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AddManualSession_Click"/>
                        </Grid>

                        <TextBlock x:Name="EmptySessionsText"
                                   Text="这一天还没有番茄钟记录。"
                                   Padding="0,16"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <ItemsControl x:Name="SessionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF7F6F2"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,9">
                                        <Expander Header="{Binding Header}"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  FontWeight="SemiBold">
                                            <StackPanel Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="分钟数"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBox Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,4,12,0"
                                                                 HorizontalContentAlignment="Center"
                                                                 TextChanged="SessionText_Changed"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              Content="计入完成数量"
                                                              Margin="0,17,0,0"
                                                              IsChecked="{Binding CountsTowardGoal, Mode=TwoWay}"
                                                              Checked="SessionField_Changed"
                                                              Unchecked="SessionField_Changed"/>
                                                    <Button Grid.Column="2"
                                                            Content="删除"
                                                            Margin="10,11,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="DeleteSession_Click"/>
                                                </Grid>

                                                <TextBlock Text="这个番茄钟的 Notes"
                                                           Margin="0,10,0,4"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="58"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextChanged="SessionText_Changed"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="今日 Notes"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBox x:Name="DailyNotesBox"
                                 Margin="0,10,0,0"
                                 MinHeight="110"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="DayField_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="复制当天文本"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyDay_Click"/>
                    <Button Content="导出 Markdown"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExportMarkdown_Click"/>
                    <Button Content="保存"
                            Width="88"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
