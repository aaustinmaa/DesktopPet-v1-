<Window x:Class="DesktopPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和苏无度聊聊"
        Width="500" Height="520"
        MinWidth="390" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ScreenToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SwitchLabel"
                                           Text="看屏幕"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="SwitchTrack"
                                        Width="24"
                                        Height="14"
                                        Margin="6,0,0,0"
                                        Background="{StaticResource SubtleSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="8"
                                             Height="8"
                                             Margin="2"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource MutedBrush}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTranslate"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchSurface"
                                        Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchThumb"
                                        Property="Fill"
                                        Value="{StaticResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="SwitchLabel"
                                        Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="10"
                                                             Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatMessageInputStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="Padding" Value="3,4"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MaxHeight" Value="96"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BubbleCopyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,-5,-6,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="BubbleCopyButtonOnDarkStyle"
               TargetType="Button"
               BasedOn="{StaticResource BubbleCopyButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        </Style>

        <Style x:Key="CompactActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFD9E9E6"/>
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#FFC2DDD8"/>
        <SolidColorBrush x:Key="SidebarSelectedHoverBrush" Color="#FFB2D2CC"/>

        <Style x:Key="SidebarHeaderButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseEnter"
                         Handler="SidebarTextButton_MouseEnter"/>
            <EventSetter Event="MouseLeave"
                         Handler="SidebarTextButton_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ThreadContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ThreadContent" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThreadContent" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Margin="0,0,14,0"
                Padding="12"
                Visibility="Collapsed"
                Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="聊天"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="选择一个聊天继续"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="‹"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="收起聊天列表"
                            Click="SidebarToggle_Click"/>
                </Grid>

                <Button Grid.Row="1"
                        Content="＋  新聊天"
                        Margin="0,0,0,10"
                        HorizontalContentAlignment="Left"
                        Click="NewChat_Click"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="最近"
                                   Margin="5,2,0,4"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <StackPanel x:Name="ActiveThreadsPanel"/>

                        <Button x:Name="ArchivedToggleButton"
                                Margin="0,12,0,4"
                                Style="{StaticResource SidebarHeaderButtonStyle}"
                                Click="ArchivedToggle_Click"/>
                        <StackPanel x:Name="ArchivedThreadsPanel"
                                    Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ExpandSidebarButton"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="16"
                        Content="☰"
                        Visibility="Visible"
                        ToolTip="展开聊天列表"
                        Click="SidebarToggle_Click"/>
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock x:Name="ModeText"
                           Grid.Column="1"
                           Visibility="Collapsed"/>
                <Button x:Name="ArchiveCurrentButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Height="32"
                        MinHeight="32"
                        Padding="9,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Archive"
                        ToolTip="把当前聊天移到归档"
                        Click="ArchiveCurrent_Click"/>
                <Button x:Name="SettingsButton"
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        MinHeight="32"
                        Margin="6,0,0,0"
                        Padding="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="15"
                        Content="⚙"
                        ToolTip="打开设置"
                        AutomationProperties.Name="打开设置"
                        Click="SettingsButton_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ModernCardStyle}"
                    Padding="12">
                <ScrollViewer x:Name="ConversationScroll"
                              Padding="0,0,4,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ConversationPanel"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Style="{StaticResource ModernCardStyle}"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageBox"
                             Grid.Column="0"
                             Style="{StaticResource ChatMessageInputStyle}"
                             Margin="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="MessageBox_PreviewKeyDown"
                             ToolTip="Enter 发送，Shift+Enter 换行"/>

                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <Button x:Name="SendButton"
                                Content="发送"
                                Width="64"
                                Height="26"
                                MinHeight="26"
                                Padding="8,0"
                                HorizontalAlignment="Center"
                                Click="SendButton_Click"/>
                        <ToggleButton x:Name="ScreenVisionToggle"
                                      Margin="0,3,0,0"
                                      HorizontalAlignment="Center"
                                      Style="{StaticResource ScreenToggleStyle}"
                                      IsChecked="True"
                                      Checked="ScreenVisionToggle_Changed"
                                      Unchecked="ScreenVisionToggle_Changed"
                                      ToolTip="开启后，每次点击发送只截取一张所有显示器画面；不会持续录屏。"/>
                        <TextBlock x:Name="StatusText"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
