<Window x:Class="DesktopPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和苏无度聊聊"
        Width="520" Height="650"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ScreenToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SwitchLabel"
                                           Text="看屏幕"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="SwitchTrack"
                                        Width="30"
                                        Height="17"
                                        Margin="8,0,0,0"
                                        Background="{StaticResource SubtleSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="11"
                                             Height="11"
                                             Margin="2"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource MutedBrush}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTranslate"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchSurface"
                                        Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchThumb"
                                        Property="Fill"
                                        Value="{StaticResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="SwitchLabel"
                                        Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="13"
                                                             Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="ModeText"
                           Style="{StaticResource PageSubtitleStyle}"/>
                <Border Style="{StaticResource TitleRuleStyle}"/>
            </StackPanel>
            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Width="38"
                    Height="38"
                    Margin="12,0,0,0"
                    Padding="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontSize="17"
                    Content="⚙"
                    ToolTip="打开设置"
                    AutomationProperties.Name="打开设置"
                    Click="SettingsButton_Click"/>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource ModernCardStyle}"
                Padding="14">
            <ScrollViewer x:Name="ConversationScroll"
                          Padding="0,0,4,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ConversationPanel"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource ModernCardStyle}"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="MessageBox"
                         MinHeight="76"
                         Margin="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="MessageBox_KeyDown"
                         ToolTip="Enter 发送，Shift+Enter 换行"/>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ToggleButton x:Name="ScreenVisionToggle"
                                      Style="{StaticResource ScreenToggleStyle}"
                                      IsChecked="False"
                                      Checked="ScreenVisionToggle_Changed"
                                      Unchecked="ScreenVisionToggle_Changed"
                                      ToolTip="开启后，每次点击发送只截取一张所有显示器画面；不会持续录屏。"/>
                        <TextBlock x:Name="StatusText"
                                   Margin="8,1,8,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="发送  ↵"
                            Width="98"
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom"
                            Click="SendButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
