<Window x:Class="DesktopPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和桌宠聊聊"
        Width="430" Height="520"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF151219"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#FFF8F2DC" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ModeText" Foreground="#FF77DA91" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Width="44"
                    Height="44"
                    Background="#3328D16F"
                    CornerRadius="13">
                <TextBlock Text="♥"
                           Foreground="#FFFF4350"
                           FontSize="25"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#FF24202A"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ConversationPanel"/>
            </ScrollViewer>
        </Border>

        <TextBox x:Name="MessageBox"
                 Grid.Row="2"
                 Height="72"
                 Margin="0,14,0,7"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 KeyDown="MessageBox_KeyDown"
                 ToolTip="Enter 发送，Shift+Enter 换行"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#FFAAA3AE" VerticalAlignment="Center" FontSize="11"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="发送  ↵" Width="104" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
