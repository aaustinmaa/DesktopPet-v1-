<Window x:Class="DesktopPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和桌宠聊聊"
        Width="430" Height="520"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF151219"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <!--
            Chat-only scroll bars.  Keeping these resources local prevents the
            compact dark treatment from leaking into the light settings pages.
        -->
        <Style x:Key="ChatScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Background="#807D7582"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface"
                                        Property="Background"
                                        Value="#C0A9A1AE"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface"
                                        Property="Background"
                                        Value="#FF77DA91"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbSurface"
                                        Property="Opacity"
                                        Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Margin" Value="2,1,0,1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollBarRoot"
                              Width="8"
                              HorizontalAlignment="Right"
                              Background="#12FFFFFF">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ChatScrollPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ChatScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ChatScrollPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="7"/>
                                <Setter Property="Margin" Value="1,2,1,0"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter TargetName="ScrollBarRoot"
                                        Property="Width"
                                        Value="Auto"/>
                                <Setter TargetName="ScrollBarRoot"
                                        Property="Height"
                                        Value="7"/>
                                <Setter TargetName="ScrollBarRoot"
                                        Property="HorizontalAlignment"
                                        Value="Stretch"/>
                                <Setter TargetName="PART_Track"
                                        Property="IsDirectionReversed"
                                        Value="False"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollBarRoot"
                                        Property="Background"
                                        Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#FFF8F2DC" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ModeText" Foreground="#FF77DA91" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Width="44"
                    Height="44"
                    Background="#3328D16F"
                    CornerRadius="13">
                <TextBlock Text="♥"
                           Foreground="#FFFF4350"
                           FontSize="25"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#FF24202A"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12">
            <ScrollViewer x:Name="ConversationScroll"
                          Padding="0,0,2,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ConversationPanel"/>
            </ScrollViewer>
        </Border>

        <TextBox x:Name="MessageBox"
                 Grid.Row="2"
                 Height="72"
                 Margin="0,14,0,7"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 KeyDown="MessageBox_KeyDown"
                 ToolTip="Enter 发送，Shift+Enter 换行"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#FFAAA3AE" VerticalAlignment="Center" FontSize="11"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="发送  ↵" Width="104" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
