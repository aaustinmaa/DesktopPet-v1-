<Window x:Class="DesktopPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度桌宠设置"
        Width="540" Height="790"
        MinWidth="480" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,23,25,25">
                <TextBlock Text="桌宠设置"
                           FontSize="27"
                           FontWeight="Bold"/>
                <TextBlock Text="调整苏无度的外观、陪伴方式和可选 AI。"
                           Margin="0,5,0,20"
                           Foreground="{StaticResource MutedBrush}"/>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="外观与行为"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="名字" FontWeight="SemiBold" Margin="0,15,0,0"/>
                        <TextBox x:Name="PetNameBox"/>

                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="桌宠大小" FontWeight="SemiBold"/>
                                <Slider x:Name="ScaleSlider"
                                        Margin="0,7,12,0"
                                        Minimum="0.55"
                                        Maximum="1.5"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScaleSlider_ValueChanged"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#FFE7F7ED"
                                    CornerRadius="9"
                                    Padding="7,5"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1">
                                <TextBlock x:Name="ScaleLabel"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <CheckBox x:Name="TopmostBox" Content="始终置顶"/>
                        <CheckBox x:Name="WanderBox" Content="偶尔在屏幕附近漫游"/>
                        <CheckBox x:Name="StartupBox" Content="登录 Windows 时自动启动"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="专注与提醒"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <CheckBox x:Name="HydrationBox"
                                  Content="启用喝水提醒"
                                  Margin="0,13,0,8"/>

                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="喝水提醒间隔" FontWeight="SemiBold"/>
                                <TextBlock Text="10–240 分钟"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="HydrationBoxMinutes"
                                     Grid.Column="1"
                                     Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="默认专注时长" FontWeight="SemiBold"/>
                                <TextBlock Text="1–120 分钟"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="FocusBoxMinutes"
                                     Grid.Column="1"
                                     Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,2,0,12"/>
                        <TextBlock Text="番茄钟铃声"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="开始与结束可以使用不同提示音；选择“静音”即可关闭。"
                                   Margin="0,2,0,9"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始铃声" FontSize="12"/>
                                <ComboBox x:Name="FocusStartSoundBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          Margin="0,4,10,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="试听"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1"
                                    Click="PreviewFocusStartSound_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="结束铃声" FontSize="12"/>
                                <ComboBox x:Name="FocusCompleteSoundBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          Margin="0,4,10,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="试听"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1"
                                    Click="PreviewFocusCompleteSound_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AI 与记忆"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="推荐直接连接自己的 ChatGPT；也可以改用开发者 API 或完全离线。"
                                   Margin="0,6,0,13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>

                        <TextBlock Text="聊天方式" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <UniformGrid Columns="3" Margin="-4,0,-4,10">
                            <Button x:Name="CodexProviderButton"
                                    Content="ChatGPT 登录"
                                    Tag="codex"
                                    Click="Provider_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button x:Name="OpenAiProviderButton"
                                    Content="API key"
                                    Tag="openai"
                                    Click="Provider_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button x:Name="OfflineProviderButton"
                                    Content="离线"
                                    Tag="offline"
                                    Click="Provider_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </UniformGrid>

                        <Border x:Name="CodexPanel"
                                Background="#FFF3FAF5"
                                BorderBrush="#FFD9EDE0"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="用 ChatGPT 账号连接"
                                           FontWeight="Bold"/>
                                <TextBlock Text="会打开浏览器完成官方 OAuth 登录；不读取密码，也不需要 API key。使用你账号中可用的 Codex 订阅额度。"
                                           Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                                <TextBlock x:Name="CodexStatusText"
                                           Text="正在检查连接…"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="-4,7,0,0">
                                    <Button x:Name="CodexConnectButton"
                                            Content="连接我的 ChatGPT"
                                            Click="CodexConnect_Click"/>
                                    <Button x:Name="CodexLogoutButton"
                                            Content="退出登录"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CodexLogout_Click"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock Text="Codex 模型"
                                           FontWeight="SemiBold"
                                           Margin="0,7,0,0"/>
                                <TextBlock Text="列表由当前 ChatGPT 账号实时提供；“自动选择”最不容易遇到兼容问题。"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0"/>
                                <ComboBox x:Name="CodexModelBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedValuePath="ModelId"
                                          IsEditable="False"
                                          SelectionChanged="CodexModelBox_SelectionChanged"/>
                                <TextBlock x:Name="CodexModelHintText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="1,0,0,0"/>
                                <TextBlock Text="推理强度"
                                           FontWeight="SemiBold"
                                           Margin="0,11,0,0"/>
                                <TextBlock Text="选项会随模型变化；越高通常越慢，也会使用更多推理 token。"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0"/>
                                <ComboBox x:Name="CodexReasoningBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedValuePath="Effort"
                                          IsEditable="False"
                                          SelectionChanged="CodexReasoningBox_SelectionChanged"/>
                                <TextBlock x:Name="CodexReasoningHintText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="1,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OpenAiPanel"
                                Background="#FFF7F6F2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="OpenAI 开发者 API"
                                           FontWeight="Bold"/>
                                <TextBlock Text="API 与 ChatGPT 订阅分开计费。key 使用 Windows DPAPI 加密，仅当前 Windows 用户可解密。"
                                           Margin="0,4,0,9"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                                <TextBlock Text="模型" FontWeight="SemiBold"/>
                                <TextBox x:Name="ModelBox"/>
                                <TextBlock Text="新的 API key" FontWeight="SemiBold"/>
                                <TextBlock Text="留空表示保持当前设置"
                                           Margin="0,2,0,3"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,6"/>
                                <TextBlock x:Name="ApiStatusText"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <Button Content="清除已保存的 API key"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ClearApiKey_Click"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OfflinePanel"
                                Background="#FFF7F6F2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock Text="不联网，也不发送任何聊天内容。苏无度仍会回应问候、休息、完成任务等简单消息。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"/>
                        </Border>

                        <CheckBox x:Name="MemoryBox"
                                  Content="保存最近聊天，并记住我明确要求“记住”的内容"/>
                        <TextBlock Text="数据保存在本机 LocalAppData，不会与 ChatGPT 网页记忆同步。"
                                   Margin="28,-2,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                        <Button Content="清除苏无度的聊天与记忆"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="ClearMemory_Click"
                                Margin="24,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="#FFF0ECE2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="保存"
                        Width="102"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
