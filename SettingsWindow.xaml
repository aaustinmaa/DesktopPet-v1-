<Window x:Class="DesktopPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="苏无度桌宠设置"
        Width="620" Height="820"
        MinWidth="520" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,25,28,28">
                <TextBlock Text="桌宠设置"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="调整苏无度的外观、陪伴方式和可选 AI。"
                           Margin="0,5,0,20"
                           Foreground="{StaticResource MutedBrush}"/>
                <Border Style="{StaticResource TitleRuleStyle}"
                        Margin="0,-8,0,20"/>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="外观与行为"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="名字" FontWeight="SemiBold" Margin="0,15,0,0"/>
                        <TextBox x:Name="PetNameBox"/>

                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="桌宠大小" FontWeight="SemiBold"/>
                                <Slider x:Name="ScaleSlider"
                                        Margin="0,7,12,0"
                                        Minimum="0.20"
                                        Maximum="1.5"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScaleSlider_ValueChanged"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="9"
                                    Padding="7,5"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1">
                                <TextBlock x:Name="ScaleLabel"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <CheckBox x:Name="TopmostBox" Content="始终置顶"/>
                        <CheckBox x:Name="WanderBox" Content="偶尔在屏幕附近漫游"/>
                        <Grid Margin="24,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="漫游停留范围（秒）"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="每次移动或判断前随机等待，3–300 秒"
                                           Margin="0,2,8,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox x:Name="WanderMinIdleSecondsBox"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="–"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="WanderMaxIdleSecondsBox"
                                     Grid.Column="3"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"/>
                        </Grid>
                        <CheckBox x:Name="StartupBox" Content="登录 Windows 时自动启动"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="专注与提醒"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox x:Name="HydrationBox"
                                  Content="启用喝水提醒"
                                  Margin="0,13,0,8"/>

                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="喝水提醒间隔" FontWeight="SemiBold"/>
                                <TextBlock Text="10–240 分钟"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="HydrationBoxMinutes"
                                     Grid.Column="1"
                                     Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="默认专注时长" FontWeight="SemiBold"/>
                                <TextBlock Text="1–120 分钟"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="FocusBoxMinutes"
                                     Grid.Column="1"
                                     Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,2,0,12"/>
                        <TextBlock Text="番茄钟铃声"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="开始与结束可以使用不同提示音；选择“静音”即可关闭。"
                                   Margin="0,2,0,9"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始铃声" FontSize="12"/>
                                <ComboBox x:Name="FocusStartSoundBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          Margin="0,4,10,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="试听"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1"
                                    Click="PreviewFocusStartSound_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="结束铃声" FontSize="12"/>
                                <ComboBox x:Name="FocusCompleteSoundBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          Margin="0,4,10,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="试听"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1"
                                    Click="PreviewFocusCompleteSound_Click"/>
                        </Grid>

                        <Separator Margin="0,14,0,12"/>
                        <TextBlock Text="随机提示音与微休息"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="只在番茄钟运行期间生效。每轮会重新随机抽取专注间隔；第一声开始休息，第二声继续工作。"
                                   Margin="0,2,0,8"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                        <CheckBox x:Name="RandomCueEnabledBox"
                                  Content="启用番茄钟内的随机微休息"
                                  Margin="0,2,0,9"
                                  Checked="RandomCueEnabled_Changed"
                                  Unchecked="RandomCueEnabled_Changed"/>

                        <StackPanel x:Name="RandomCueOptionsPanel">
                            <UniformGrid Columns="3" Margin="-5,0,-5,8">
                                <StackPanel Margin="5,0">
                                    <TextBlock Text="最短间隔（分钟）"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBox x:Name="RandomCueMinMinutesBox"
                                             Margin="0,4,0,0"
                                             HorizontalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <TextBlock Text="最长间隔（分钟）"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBox x:Name="RandomCueMaxMinutesBox"
                                             Margin="0,4,0,0"
                                             HorizontalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <TextBlock Text="休息时长（秒）"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBox x:Name="RandomCueBreakSecondsBox"
                                             Margin="0,4,0,0"
                                             HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="第一声：开始休息" FontSize="12"/>
                                    <ComboBox x:Name="RandomCueBreakSoundBox"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              Margin="0,4,10,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="试听"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,1"
                                        Click="PreviewRandomCueBreakSound_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="第二声：继续工作" FontSize="12"/>
                                    <ComboBox x:Name="RandomCueResumeSoundBox"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              Margin="0,4,10,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="试听"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,1"
                                        Click="PreviewRandomCueResumeSound_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AI 与记忆"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="推荐直接连接自己的 ChatGPT；也可以改用开发者 API 或完全离线。"
                                   Margin="0,6,0,13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>

                        <TextBlock Text="聊天方式" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <UniformGrid Columns="3" Margin="-4,0,-4,10">
                            <Button x:Name="CodexProviderButton"
                                    Content="ChatGPT 登录"
                                    Tag="codex"
                                    Click="Provider_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button x:Name="OpenAiProviderButton"
                                    Content="API key"
                                    Tag="openai"
                                    Click="Provider_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button x:Name="OfflineProviderButton"
                                    Content="离线"
                                    Tag="offline"
                                    Click="Provider_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </UniformGrid>

                        <Border x:Name="CodexPanel"
                                Style="{StaticResource InnerPanelStyle}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="用 ChatGPT 账号连接"
                                           FontWeight="Bold"/>
                                <TextBlock Text="会打开浏览器完成官方 OAuth 登录；不读取密码，也不需要 API key。授权只保存在苏无度自己的本地空间，不与其他 Codex 客户端共用。"
                                           Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                                <TextBlock x:Name="CodexStatusText"
                                           Text="正在检查连接…"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="-4,7,0,0">
                                    <Button x:Name="CodexConnectButton"
                                            Content="连接我的 ChatGPT"
                                            Click="CodexConnect_Click"/>
                                    <Button x:Name="CodexLogoutButton"
                                            Content="断开连接"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CodexLogout_Click"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock Text="Codex 模型"
                                           FontWeight="SemiBold"
                                           Margin="0,7,0,0"/>
                                <TextBlock Text="列表由当前 ChatGPT 账号实时提供；“自动选择”最不容易遇到兼容问题。"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0"/>
                                <ComboBox x:Name="CodexModelBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedValuePath="ModelId"
                                          IsEditable="False"
                                          SelectionChanged="CodexModelBox_SelectionChanged"/>
                                <TextBlock x:Name="CodexModelHintText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="1,0,0,0"/>
                                <TextBlock Text="推理强度"
                                           FontWeight="SemiBold"
                                           Margin="0,11,0,0"/>
                                <TextBlock Text="选项会随模型变化；越高通常越慢，也会使用更多推理 token。"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0"/>
                                <ComboBox x:Name="CodexReasoningBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedValuePath="Effort"
                                          IsEditable="False"
                                          SelectionChanged="CodexReasoningBox_SelectionChanged"/>
                                <TextBlock x:Name="CodexReasoningHintText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="1,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OpenAiPanel"
                                Style="{StaticResource InnerPanelStyle}"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="OpenAI 开发者 API"
                                           FontWeight="Bold"/>
                                <TextBlock Text="API 与 ChatGPT 订阅分开计费。key 使用 Windows DPAPI 加密，仅当前 Windows 用户可解密。"
                                           Margin="0,4,0,9"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                                <TextBlock Text="模型" FontWeight="SemiBold"/>
                                <TextBox x:Name="ModelBox"/>
                                <TextBlock Text="新的 API key" FontWeight="SemiBold"/>
                                <TextBlock Text="留空表示保持当前设置"
                                           Margin="0,2,0,3"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,6"/>
                                <TextBlock x:Name="ApiStatusText"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <Button Content="清除已保存的 API key"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ClearApiKey_Click"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OfflinePanel"
                                Style="{StaticResource InnerPanelStyle}"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock Text="不联网，也不发送任何聊天内容。苏无度仍会回应问候、休息、完成任务等简单消息。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"/>
                        </Border>

                        <CheckBox x:Name="MemoryBox"
                                  Content="开启记忆功能"/>
                        <TextBlock Text="所有聊天都会保存在本机；开启后，苏无度还会跨聊天使用精简记忆和你明确要求记住的内容。"
                                   Margin="28,-2,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                        <Button Content="清除所有聊天与记忆"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="ClearMemory_Click"
                                Margin="24,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Style="{StaticResource FooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="保存"
                        Width="102"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
